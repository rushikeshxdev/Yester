{
  "name": "yester",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@yester/web",
    "dev:web": "npm run dev --workspace=@yester/web",
    "dev:api": "npm run dev --workspace=@yester/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@yester/web",
    "build:api": "npm run build --workspace=@yester/api",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test --workspace=@yester/web",
    "test:api": "npm run test --workspace=@yester/api",
    "preview:web": "npm run preview --workspace=@yester/web"
  }
}
